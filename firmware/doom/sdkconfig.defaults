# DIABLITO - ESP32-C6, lifted from NESTOR's proven settings (which came from PELLETINO)
CONFIG_IDF_TARGET="esp32c6"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# The installed Moss bootloader enables OTA rollback. Match its OTA state
# handling so Doom can confirm a healthy first boot before normal gameplay.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_CHECK_STACKOVERFLOW_CANARY=y
CONFIG_SPI_MASTER_IN_IRAM=y
CONFIG_ESP_TASK_WDT_EN=n
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
# no power management: DFS breaks SPI DMA on this chip (PELLETINO), and Doom wants a fixed 160 MHz
CONFIG_PM_ENABLE=n

# Console on the USB-Serial-JTAG port
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# sampling profiler (components/doom/esp/prof.c)
CONFIG_ESP_TIMER_SUPPORTS_ISR_DISPATCH_METHOD=y
